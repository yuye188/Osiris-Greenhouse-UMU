   ],
   "source": [
    "LB_RUNG = \"+ day-ahead forecast\"\n",
    "LB_MODELS = [\"Ridge (hist)\", \"HistGB (hist)\", \"LSTM\", \"GRU\", \"Attention\", \"MLP\"]\n",
    "LB_GRID = (1,) + LOOKBACK_GRID\n",
    "\n",
    "def lookback_point(model_name, fs, L):\n",
    "    arch = model_name.split(\" \")[0]; cols = feature_sets[fs]\n",
    "    p = dict(best_params_log[(model_name, fs)])\n",
    "    S, F = prepare(cols, \"sel\"), prepare(cols, \"final\")\n",
    "    if arch in TABULAR:\n",
    "        ctor, _ = model_search_space()[arch]\n",
    "        hp = {k: v for k, v in p.items() if k != \"lookback\"}\n",
    "        vp = to_frame(S, ctor(hp).fit(flat(S[\"Xtr\"], L), S[\"ytr\"]).predict(flat(S[\"Xev\"], L)))\n",
    "        preds = [to_frame(F, ctor(hp).fit(flat(F[\"Xtr\"], L), F[\"ytr\"]).predict(flat(F[\"Xev\"], L)))]\n",
    "    else:\n",
    "        fn = NEURAL_BUILDERS[arch]\n",
    "        m = fn(n_features=S[\"Xtr\"].shape[-1], n_targets=len(TARGET_COLS), lookback=L, units=p[\"units\"],\n",
    "               dropout=p[\"dropout\"], lr=p[\"lr\"], optimizer=p[\"optimizer\"], seed=0)\n",
    "        es = keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=PATIENCE, restore_best_weights=True)\n",
    "        h = m.fit(last(S[\"Xtr\"], L), S[\"ytr\"], validation_data=(last(S[\"Xev\"], L), S[\"yev_s\"]),\n",
    "                  epochs=MAX_EPOCHS, batch_size=32, callbacks=[es], verbose=0)\n",
    "        vp = to_frame(S, m.predict(last(S[\"Xev\"], L), verbose=0))\n",
    "        q = {**p, \"lookback\": L, \"epochs\": int(np.argmin(h.history[\"val_loss\"])) + 1}\n",
    "        preds, _ = refit_neural(fn, q, cols)\n",
    "    te = [score(y_test, x) for x in preds]\n",
    "    return {\"val CVRMSE\": mean_cvrmse(y_val, vp),\n",
    "            \"test CVRMSE\": np.mean([s[\"CVRMSE\"].mean() for s in te]),\n",
    "            \"test CVRMSE std\": np.std([s[\"CVRMSE\"].mean() for s in te]),\n",
    "            \"test temp MAE\": np.mean([s[\"MAE\"].loc[TEMP_TARGET_COLS].mean() for s in te]),\n",
    "            \"test hum MAE\": np.mean([s[\"MAE\"].loc[HUM_TARGET_COLS].mean() for s in te])}\n",
    "\n",
    "lb_rows = {(m, L): lookback_point(m, LB_RUNG, L) for m in LB_MODELS for L in LB_GRID}\n",
    "lookback_df = pd.DataFrame(lb_rows).T\n",
    "lookback_df.index.names = [\"model\", \"L (h)\"]\n",
    "\n",
    "print(f\"Validation mean CVRMSE by history length ({LB_RUNG}) -- the column to choose L from:\")\n",
    "display(lookback_df[\"val CVRMSE\"].unstack().round(4))\n",
    "print(\"Test mean CVRMSE (mean over seeds for neural models):\")\n",
    "display(lookback_df[\"test CVRMSE\"].unstack().round(4))\n",
    "print(\"Test: seed std of mean CVRMSE:\")\n",
    "display(lookback_df[\"test CVRMSE std\"].unstack().round(4))\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 4.5), sharey=False)\n",
    "for ax, col in zip(axes, [\"val CVRMSE\", \"test CVRMSE\"]):\n",
    "    for m in LB_MODELS:\n",
    "        s = lookback_df.loc[m, col]\n",
    "        err = lookback_df.loc[m, \"test CVRMSE std\"] if col == \"test CVRMSE\" else None\n",
    "        ax.errorbar(list(LB_GRID), s.values, yerr=err, marker=\"o\", capsize=3, label=m)\n",
    "    ax.set_xscale(\"log\", base=2); ax.set_xticks(list(LB_GRID)); ax.set_xticklabels(LB_GRID)\n",
    "    ax.set_xlabel(\"history length L (hours)\"); ax.set_ylabel(\"mean CVRMSE\"); ax.set_title(col)\n",
    "axes[1].legend(fontsize=8, bbox_to_anchor=(1.01, 1), loc=\"upper left\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ce992a22",
   "metadata": {},
   "source": [
    "## 2.8 — Model ladder\n",
    "\n",
    "Models in rows, ladder rungs in columns. Reading **left → right** shows what each extra block of information buys; reading **down** compares single-timestep and history variants and model families on identical anchors.\n",
    "\n",
    "* MAE is reported **separately** for temperature (°C) and humidity (%RH) — never averaged across the two.\n",
    "* Neural entries are **mean ± std over the seeds**; tabular entries are deterministic.\n",
    "* The **validation** table is the one used for every model choice; the test tables are for reporting."
   ]
  },
