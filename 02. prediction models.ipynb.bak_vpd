   "source": [
    "def ladder_table(store, metric, target_cols=None, models=MODEL_ORDER, columns=None, std=True):\n",
    "    columns = columns or list(feature_sets)\n",
    "    def cell(m, c, which):\n",
    "        k = (m, c)\n",
    "        if k not in store[which]:\n",
    "            return np.nan\n",
    "        s = store[which][k][metric]\n",
    "        return s.loc[target_cols].mean() if target_cols else s.mean()\n",
    "    mean = pd.DataFrame({c: {m: cell(m, c, \"test\") for m in models} for c in columns})[columns]\n",
    "    if not std:\n",
    "        return mean\n",
    "    # std across seeds of the target-averaged metric\n",
    "    def sd(m, c):\n",
    "        k = (m, c)\n",
    "        if k not in store[\"test_seeds\"]:\n",
    "            return np.nan\n",
    "        vals = [(s[metric].loc[target_cols].mean() if target_cols else s[metric].mean()) for s in store[\"test_seeds\"][k]]\n",
    "        return np.std(vals)\n",
    "    sdt = pd.DataFrame({c: {m: sd(m, c) for m in models} for c in columns})[columns]\n",
    "    txt = mean.round(3).astype(str)\n",
    "    for m in models:\n",
    "        if m in NEURAL_MODELS:\n",
    "            for c in columns:\n",
    "                if not np.isnan(mean.loc[m, c]):\n",
    "                    txt.loc[m, c] = f\"{mean.loc[m, c]:.3f} ± {sdt.loc[m, c]:.3f}\"\n",
    "    return txt\n",
    "\n",
    "def add_baselines(txt, metric, target_cols=None):\n",
    "    for name, sc in ((\"persistence\", baseline_scores), (\"seasonal persistence\", seasonal_scores),\n",
    "                     (\"reference baseline\", ref_scores)):\n",
    "        v = sc[metric].loc[target_cols].mean() if target_cols else sc[metric].mean()\n",
    "        txt.loc[name] = f\"{v:.3f}\"\n",
    "    return txt\n",
    "\n",
    "print(\"TEST -- mean MAE, temperature only (degC):\")\n",
    "display(add_baselines(ladder_table(GRID, \"MAE\", TEMP_TARGET_COLS), \"MAE\", TEMP_TARGET_COLS))\n",
    "print(\"TEST -- mean MAE, humidity only (%RH):\")\n",
    "display(add_baselines(ladder_table(GRID, \"MAE\", HUM_TARGET_COLS), \"MAE\", HUM_TARGET_COLS))"
   ]
  },
