   "source": [
    "def baseline_frame(index, kind):\n",
    "    out = pd.DataFrame(index=index)\n",
    "    for h in HORIZONS:\n",
    "        for v, col in ((\"temp\", \"temp_centro\"), (\"hum\", \"hum_centro\")):\n",
    "            src = df[col] if kind == \"persistence\" else df[col].shift(24 - h)\n",
    "            out[f\"{v}_h{h}\"] = src.reindex(index).values\n",
    "    return out[TARGET_COLS]\n",
    "\n",
    "baselines_test = {k: baseline_frame(test.index, k) for k in (\"persistence\", \"seasonal persistence\")}\n",
    "baselines_val = {k: baseline_frame(val.index, k) for k in (\"persistence\", \"seasonal persistence\")}\n",
    "for k, b in {**baselines_test, **{k + \" (val)\": v for k, v in baselines_val.items()}}.items():\n",
    "    assert not b.isna().any().any(), f\"{k}: missing baseline values\"\n",
    "\n",
    "baseline_scores = score(y_test, baselines_test[\"persistence\"])\n",
    "seasonal_scores = score(y_test, baselines_test[\"seasonal persistence\"])\n",
    "\n",
    "# per-target reference baseline, chosen on VALIDATION MAE\n",
    "val_mae = {k: score(y_val, b)[\"MAE\"] for k, b in baselines_val.items()}\n",
    "ref_choice = pd.Series({c: min(val_mae, key=lambda k: val_mae[k][c]) for c in TARGET_COLS})\n",
    "ref_baseline = pd.DataFrame({c: baselines_test[ref_choice[c]][c] for c in TARGET_COLS})[TARGET_COLS]\n",
    "ref_scores = score(y_test, ref_baseline)\n",
    "\n",
    "print(\"Baselines on TEST (MAE in degC / %RH):\")\n",
    "display(pd.DataFrame({\"persistence\": baseline_scores[\"MAE\"],\n",
    "                      \"seasonal persistence\": seasonal_scores[\"MAE\"],\n",
    "                      \"reference (chosen on val)\": ref_scores[\"MAE\"],\n",
    "                      \"reference = \": ref_choice}).round(3))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c1c5c80e",
   "metadata": {},
   "source": [
    "## 2.7 — The shared model protocol\n",
    "\n",
    "All architectures go through **one** code path (`run_model()` below), so the protocol is identical by construction:\n",
    "\n",
    "| step | tabular (Ridge / RandomForest / HistGB) | neural (LSTM / GRU / Attention / MLP) |\n",
    "|---|---|---|\n",
    "| inputs | `prepare()` windows, flattened (last *L* hours) | `prepare()` windows, 3-D (last *L* hours) |\n",
    "| scalers | `StandardScaler` for features and targets fit on the training portion of the stage | same |\n",
    "| search space | small grid (`alpha` / `min_samples_leaf` / `learning_rate`) **× L** | KerasTuner `BayesianOptimization` over `units`, `dropout`, `lr`, `optimizer` **and L** |\n",
    "| selection score | mean CVRMSE, original units, on the validation anchors | same (custom KerasTuner objective `val_cvrmse`) |\n",
    "| final refit | best config on the full outer train | best config on the full outer train, for the epoch count early stopping found on validation |\n",
    "| seeds | deterministic (1 fit) | 5 seeds; reported as mean ± std |\n",
    "\n",
    "*L* is fixed to 1 for the **t only** variants and searched over `LOOKBACK_GRID = (3, 6, 12, 24)` for the **history** variants — so a history model can pick a short window if the longer one mostly adds noise (the question raised in review), and 2.7n shows the full sensitivity curve.\n",
    "\n",
    "Model names: `Ridge`, `RandomForest`, `HistGB` (t only), `Ridge (hist)` … (history); `LSTM (t only)` … (t only), `LSTM`, `GRU`, `Attention`, `MLP` (history)."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6c97ef7d",
   "metadata": {},
   "source": [
    "## 2.7a — Window builder and the selection / final stages\n",
    "\n",
    "`prepare(cols, stage)` builds, once per feature list and stage, the scaled 24 h windows for the fit anchors and the evaluation anchors:\n",
    "\n",
    "* `stage=\"sel\"` — frame `data_sel` (selection clustering), scalers fit on `t < inner_train_end`, fit on `idx_inner`, evaluate on `idx_val`;\n",
    "* `stage=\"final\"` — frame `data` (final clustering), scalers fit on `t < train_end`, fit on `idx_train`, evaluate on `idx_test`.\n",
    "\n",
    "Every anchor already has 24 consecutive hours behind it (2.4), so each window is a genuine 24-hour slice of the regular hourly clock. Models that use a shorter history take the **last *L* hours** of the same window."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "633d3024",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "final-stage windows: (1070, 24, 86) -> (292, 24, 86)\n"
     ]
    }
   ],
   "source": [
    "STAGES = {\n",
    "    \"sel\":   dict(frame=data_sel, fit_end=splits[\"inner_train_end\"], fit_idx=idx_inner, eval_idx=idx_val),\n",
    "    \"final\": dict(frame=data,     fit_end=splits[\"train_end\"],       fit_idx=idx_train, eval_idx=idx_test),\n",
    "}\n",
    "_PREP_CACHE = {}\n",
    "\n",
    "def _windows(arr, positions, lookback):\n",
    "    offs = np.arange(-lookback + 1, 1)\n",
    "    return arr[positions[:, None] + offs[None, :]]          # (n, lookback, n_features)\n",
    "\n",
    "def prepare(cols, stage):\n",
    "    key = (tuple(cols), stage)\n",
    "    if key in _PREP_CACHE:\n",
    "        return _PREP_CACHE[key]\n",
    "    S = STAGES[stage]; fr = S[\"frame\"]\n",
    "    X = fr[cols].to_numpy(\"float64\")\n",
    "    x_scaler = StandardScaler().fit(fr.loc[fr.index < S[\"fit_end\"], cols].to_numpy(\"float64\"))\n",
    "    Xs = x_scaler.transform(X).astype(\"float32\")\n",
    "    y_scaler = StandardScaler().fit(fr.loc[S[\"fit_idx\"], TARGET_COLS].to_numpy(\"float64\"))\n",
    "    p_fit, p_ev = fr.index.get_indexer(S[\"fit_idx\"]), fr.index.get_indexer(S[\"eval_idx\"])\n",
    "    out = dict(\n",
    "        Xtr=_windows(Xs, p_fit, MAX_LOOKBACK),\n",
    "        ytr=y_scaler.transform(fr.loc[S[\"fit_idx\"], TARGET_COLS].to_numpy(\"float64\")).astype(\"float32\"),\n",
    "        Xev=_windows(Xs, p_ev, MAX_LOOKBACK),\n",
    "        yev=fr.loc[S[\"eval_idx\"], TARGET_COLS],\n",
    "        yev_s=y_scaler.transform(fr.loc[S[\"eval_idx\"], TARGET_COLS].to_numpy(\"float64\")).astype(\"float32\"),\n",
    "        y_scaler=y_scaler, ev_index=S[\"eval_idx\"],\n",
    "    )\n",
    "    _PREP_CACHE[key] = out\n",
    "    return out\n",
    "\n",
    "def last(X, L):          # last L hours of each window (3-D)\n",
    "    return X[:, -L:, :]\n",
    "\n",
    "def flat(X, L):          # last L hours, flattened for the tabular models\n",
    "    return X[:, -L:, :].reshape(len(X), -1)\n",
    "\n",
    "def to_frame(P, pred_scaled):\n",
    "    return pd.DataFrame(P[\"y_scaler\"].inverse_transform(pred_scaled), index=P[\"ev_index\"], columns=TARGET_COLS)\n",
    "\n",
    "_P = prepare(feature_sets[\"+ day-ahead forecast\"], \"final\")\n",
    "print(\"final-stage windows:\", _P[\"Xtr\"].shape, \"->\", _P[\"Xev\"].shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1af2b91c",
   "metadata": {},
   "source": [
    "## 2.7b — Tabular models: search space, selection, refit\n",
    "\n",
    "`run_tabular()` evaluates every (hyper-parameter, *L*) pair on validation by **mean CVRMSE in original units** (targets are standardised for fitting, so predictions are inverse-transformed before scoring — the earlier version scored standardised, centred targets, which is not CVRMSE), refits the winner on the full outer train and predicts test once."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "c90ba71b",
   "metadata": {},
   "outputs": [],
   "source": [
    "TABULAR = [\"Ridge\", \"RandomForest\", \"HistGB\"]\n",
    "\n",
    "def model_search_space():\n",
    "    \"\"\"model name -> (constructor(params) -> unfitted estimator, small param grid).\"\"\"\n",
    "    return {\n",
    "        \"Ridge\": (\n",
    "            lambda p: make_pipeline(StandardScaler(), Ridge(alpha=p[\"alpha\"])),\n",
    "            [{\"alpha\": a} for a in (0.1, 1.0, 10.0, 100.0, 1000.0)],\n",
    "        ),\n",
    "        \"RandomForest\": (\n",
    "            lambda p: RandomForestRegressor(\n",
    "                n_estimators=RF_TREES, min_samples_leaf=p[\"min_samples_leaf\"],\n",
    "                n_jobs=-1, random_state=0),\n",
    "            [{\"min_samples_leaf\": v} for v in (1, 2, 5)],\n",
    "        ),\n",
    "        \"HistGB\": (\n",
    "            lambda p: MultiOutputRegressor(HistGradientBoostingRegressor(\n",
    "                max_iter=HGB_ITER, learning_rate=p[\"learning_rate\"], random_state=0)),\n",
    "            [{\"learning_rate\": v} for v in (0.03, 0.05, 0.1)],\n",
    "        ),\n",
    "    }\n",
    "\n",
    "def run_tabular(arch, cols, lookbacks):\n",
    "    ctor, grid = model_search_space()[arch]\n",
    "    S = prepare(cols, \"sel\")\n",
    "    best = (np.inf, None, None, None)\n",
    "    for L in lookbacks:\n",
    "        Xtr, Xev = flat(S[\"Xtr\"], L), flat(S[\"Xev\"], L)\n",
    "        for p in grid:\n",
    "            m = ctor(p).fit(Xtr, S[\"ytr\"])\n",
    "            vp = to_frame(S, m.predict(Xev))\n",
    "            crit = mean_cvrmse(S[\"yev\"], vp)\n",
    "            if crit < best[0]:\n",
    "                best = (crit, p, L, vp)\n",
    "    crit, p, L, vp = best\n",
    "    F = prepare(cols, \"final\")\n",
    "    m = ctor(p).fit(flat(F[\"Xtr\"], L), F[\"ytr\"])\n",
    "    return dict(val_pred=vp, val_crit=crit, test_preds=[to_frame(F, m.predict(flat(F[\"Xev\"], L)))],\n",
    "                params={**p, \"lookback\": L}, n_params=np.nan)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b3f2a941",
   "metadata": {},
   "source": [
    "## 2.7c — Neural models: one tuner, one objective, one refit\n",
    "\n",
    "`NeuralHyperModel` is a KerasTuner `HyperModel` whose `fit()` trains on the inner-train windows with early stopping on the validation windows and **returns the validation mean CVRMSE in original units** as the objective (`val_cvrmse`). That is exactly the tabular criterion on exactly the same validation anchors; the earlier version optimised standardised MSE on a Keras `validation_split` whose dates differed per model. The history length *L* is part of the search space for the history variants.\n",
    "\n",
    "After the search, the winning configuration is **rebuilt from scratch and refit on the full outer train** for the number of epochs early stopping selected on validation (no validation data is held back in the final fit, mirroring the tabular refit), once per seed in `SEEDS`. Rebuilding also sidesteps KerasTuner's optimizer-checkpoint warning.\n",
    "\n",
    "Note on `max_trials`: Bayesian search over 4–5 hyper-parameters with `MAX_TRIALS = 20` is a modest budget; 2.7l shows what won."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "c538ccee",
   "metadata": {},
   "outputs": [],
   "source": [
    "KT_DIR = \"kt_tuning\"   # keras-tuner scratch directory; safe to delete between runs\n",
    "NEURAL_BUILDERS = {}   # filled in 2.7d-2.7g\n",
    "\n",
    "def _safe_name(s):\n",
    "    return \"\".join(c if c.isalnum() else \"_\" for c in s)\n",
    "\n",
    "def make_optimizer(name, lr):\n",
    "    ctor = {\"adam\": keras.optimizers.Adam, \"rmsprop\": keras.optimizers.RMSprop}[name]\n",
    "    return ctor(lr)\n",
    "\n",
    "class NeuralHyperModel(kt.HyperModel):\n",
    "    def __init__(self, make_fn, S, lookbacks):\n",
    "        super().__init__()\n",
    "        self.make_fn, self.S, self.lookbacks = make_fn, S, tuple(lookbacks)\n",
    "        self.log = []                         # one entry per completed trial\n",
    "\n",
    "    def build(self, hp):\n",
    "        L = hp.Choice(\"lookback\", list(self.lookbacks)) if len(self.lookbacks) > 1 else self.lookbacks[0]\n",
    "        return self.make_fn(n_features=self.S[\"Xtr\"].shape[-1], n_targets=len(TARGET_COLS), lookback=L,\n",
    "                            units=hp.Int(\"units\", 16, 128, step=16), dropout=hp.Float(\"dropout\", 0.0, 0.4),\n",
    "                            lr=hp.Float(\"lr\", 1e-4, 1e-2, sampling=\"log\"),\n",
    "                            optimizer=hp.Choice(\"optimizer\", [\"adam\", \"rmsprop\"]))\n",
    "\n",
    "    def fit(self, hp, model, *args, **kwargs):\n",
    "        L = hp.get(\"lookback\") if len(self.lookbacks) > 1 else self.lookbacks[0]\n",
    "        S = self.S\n",
    "        es = keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=PATIENCE, restore_best_weights=True)\n",
    "        h = model.fit(last(S[\"Xtr\"], L), S[\"ytr\"], validation_data=(last(S[\"Xev\"], L), S[\"yev_s\"]),\n",
    "                      epochs=MAX_EPOCHS, batch_size=32, callbacks=[es], verbose=0)\n",
    "        best_epoch = int(np.argmin(h.history[\"val_loss\"])) + 1\n",
    "        vp = to_frame(S, model.predict(last(S[\"Xev\"], L), verbose=0))\n",
    "        crit = mean_cvrmse(S[\"yev\"], vp)\n",
    "        self.log.append(dict(hp=dict(hp.values), epochs=best_epoch, val_pred=vp, crit=crit))\n",
    "        return {\"val_cvrmse\": crit}\n",
    "\n",
    "def refit_neural(make_fn, params, cols, seeds=SEEDS):\n",
    "    \"\"\"Refit params on the full outer train for params['epochs'] epochs, once per seed.\"\"\"\n",
    "    F = prepare(cols, \"final\"); L = params[\"lookback\"]\n",
    "    preds, n_params = [], None\n",
    "    for seed in seeds:\n",
    "        m = make_fn(n_features=F[\"Xtr\"].shape[-1], n_targets=len(TARGET_COLS), lookback=L,\n",
    "                    units=params[\"units\"], dropout=params[\"dropout\"], lr=params[\"lr\"],\n",
    "                    optimizer=params[\"optimizer\"], seed=seed)\n",
    "        n_params = n_params or m.count_params()\n",
    "        m.fit(last(F[\"Xtr\"], L), F[\"ytr\"], epochs=params[\"epochs\"], batch_size=32, verbose=0)\n",
    "        preds.append(to_frame(F, m.predict(last(F[\"Xev\"], L), verbose=0)))\n",
    "    return preds, n_params\n",
    "\n",
    "def run_neural(arch, cols, lookbacks, label):\n",
    "    S = prepare(cols, \"sel\")\n",
    "    hm = NeuralHyperModel(NEURAL_BUILDERS[arch], S, lookbacks)\n",
    "    tuner = kt.BayesianOptimization(\n",
    "        hypermodel=hm, objective=kt.Objective(\"val_cvrmse\", direction=\"min\"),\n",
    "        max_trials=MAX_TRIALS, seed=0, directory=KT_DIR, project_name=_safe_name(label), overwrite=True)\n",
    "    tuner.search(verbose=0)\n",
    "    assert hm.log, f\"{label}: no KerasTuner trial completed -- check the tuner output above\"\n",
    "    best = min(hm.log, key=lambda e: e[\"crit\"])      # same objective the tuner minimises\n",
    "    vp, crit = best[\"val_pred\"], best[\"crit\"]\n",
    "    params = {k: best[\"hp\"][k] for k in (\"units\", \"dropout\", \"lr\", \"optimizer\")}\n",
    "    params[\"lookback\"] = best[\"hp\"].get(\"lookback\", lookbacks[0])\n",
    "    params[\"epochs\"] = best[\"epochs\"]\n",
    "    preds, n_params = refit_neural(NEURAL_BUILDERS[arch], params, cols)\n",
    "    return dict(val_pred=vp, val_crit=crit, test_preds=preds, params=params, n_params=n_params)\n",
    "\n",
    "def model_key(arch, hist):\n",
    "    if arch in TABULAR:\n",
    "        return f\"{arch} (hist)\" if hist else arch\n",
    "    return arch if hist else f\"{arch} (t only)\"\n",
    "\n",
    "def run_model(arch, cols, hist, label):\n",
    "    lookbacks = LOOKBACK_GRID if hist else (1,)\n",
    "    if arch in TABULAR:\n",
    "        return run_tabular(arch, cols, lookbacks)\n",
    "    return run_neural(arch, cols, lookbacks, label)\n",
    "\n",
    "# ---- result stores ----------------------------------------------------------------\n",
    "def new_store():\n",
    "    return {k: {} for k in (\"test\", \"test_std\", \"test_seeds\", \"pred\", \"val\", \"val_pred\", \"params\", \"n_params\")}\n",
    "\n",
    "def register(store, key, out):\n",
    "    mean_s, std_s = score_seeds(y_test, out[\"test_preds\"])\n",
    "    store[\"test\"][key], store[\"test_std\"][key] = mean_s, std_s\n",
    "    store[\"test_seeds\"][key] = [score(y_test, p) for p in out[\"test_preds\"]]\n",
    "    store[\"pred\"][key] = out[\"test_preds\"]\n",
    "    store[\"val\"][key] = score(y_val, out[\"val_pred\"])\n",
    "    store[\"val_pred\"][key] = out[\"val_pred\"]\n",
    "    store[\"params\"][key] = out[\"params\"]\n",
    "    store[\"n_params\"][key] = out[\"n_params\"]\n",
    "\n",
    "GRID = new_store()\n",
    "# convenient aliases used throughout the rest of the notebook\n",
    "results, results_std, results_seeds = GRID[\"test\"], GRID[\"test_std\"], GRID[\"test_seeds\"]\n",
    "predictions, val_results, best_params_log = GRID[\"pred\"], GRID[\"val\"], GRID[\"params\"]\n",
    "\n",
    "def run_grid(arch, hist):\n",
    "    for fs_name, cols in feature_sets.items():\n",
    "        key = (model_key(arch, hist), fs_name)\n",
    "        out = run_model(arch, cols, hist, label=f\"{key[0]}_{fs_name}\")\n",
    "        register(GRID, key, out)\n",
    "        print(f\"{key[0]:>24} | {fs_name:<22} | val mean CVRMSE {out['val_crit']:.4f} | {out['params']}\")"
   ]
  },
  {
