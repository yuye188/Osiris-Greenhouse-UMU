   "source": [
    "def vpd_kpa(temp_c, rh_pct):\n",
    "    \"\"\"Vapour pressure deficit (kPa) from temperature (°C) and relative humidity (%), Tetens equation.\"\"\"\n",
    "    es = 0.6108 * np.exp(17.27 * temp_c / (temp_c + 237.3))\n",
    "    return es * (1 - rh_pct / 100.0)\n",
    "\n",
    "def vpd_frame(pred):\n",
    "    return pd.DataFrame({h: vpd_kpa(pred[f\"temp_h{h}\"], pred[f\"hum_h{h}\"]) for h in HORIZONS})\n",
    "\n",
    "horizons = HORIZONS\n",
    "vpd_real = vpd_frame(y_test)\n",
    "vpd_sources = {\"model\": [vpd_frame(p) for p in best_preds],\n",
    "               \"persistence\": [vpd_frame(baselines_test[\"persistence\"])],\n",
    "               \"seasonal persistence\": [vpd_frame(baselines_test[\"seasonal persistence\"])]}\n",
    "\n",
    "def vpd_reg_scores(vlist):\n",
    "    per = [pd.DataFrame({\"MAE\": {h: mean_absolute_error(vpd_real[h], v[h]) for h in horizons},\n",
    "                         \"CVRMSE\": {h: cvrmse(vpd_real[h], v[h]) for h in horizons},\n",
    "                         \"R2\": {h: r2_score(vpd_real[h], v[h]) for h in horizons}}) for v in vlist]\n",
    "    return sum(per) / len(per)\n",
    "\n",
    "vpd_scores = pd.concat({k: vpd_reg_scores(v) for k, v in vpd_sources.items()}, axis=1)\n",
    "vpd_scores.index.name = \"horizon (h)\"\n",
    "print(f\"VPD -- model: {best_key[0]} ({best_key[1]}); MAE in kPa, CVRMSE/R2 unitless\")\n",
    "vpd_scores.round(3)"
   ]
  },
