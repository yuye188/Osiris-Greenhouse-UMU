   "source": [
    "print(\"TEST -- mean MAE, temperature only (degC):\")\n",
    "display(add_baselines(ladder_table(RG, \"MAE\", TEMP_TARGET_COLS, columns=REGIME_ORDER), \"MAE\", TEMP_TARGET_COLS))\n",
    "print(\"TEST -- mean MAE, humidity only (%RH):\")\n",
    "display(add_baselines(ladder_table(RG, \"MAE\", HUM_TARGET_COLS, columns=REGIME_ORDER), \"MAE\", HUM_TARGET_COLS))\n",
    "print(\"TEST -- mean CVRMSE (unitless):\")\n",
    "display(add_baselines(ladder_table(RG, \"CVRMSE\", columns=REGIME_ORDER), \"CVRMSE\"))\n",
    "\n",
    "# validation-selected model per regime, reported on test\n",
    "sel_rows = {}\n",
    "for rg in REGIME_ORDER:\n",
    "    cands = [k for k in RG[\"val\"] if k[1] == rg]\n",
    "    k = min(cands, key=lambda kk: RG[\"val\"][kk][\"CVRMSE\"].mean())\n",
    "    sel_rows[rg] = {\"selected on val\": k[0], \"val mean CVRMSE\": RG[\"val\"][k][\"CVRMSE\"].mean(),\n",
    "                    \"test mean CVRMSE\": RG[\"test\"][k][\"CVRMSE\"].mean(),\n",
    "                    \"test temp MAE\": RG[\"test\"][k][\"MAE\"].loc[TEMP_TARGET_COLS].mean(),\n",
    "                    \"test hum MAE\": RG[\"test\"][k][\"MAE\"].loc[HUM_TARGET_COLS].mean()}\n",
    "print(\"Validation-selected model per regime:\")\n",
    "pd.DataFrame(sel_rows).T"
   ]
  },
  {
   "cell_type": "markdown",
