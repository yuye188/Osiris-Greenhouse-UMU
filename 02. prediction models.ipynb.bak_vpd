   "source": [
    "val_rank = pd.Series({k: v[\"CVRMSE\"].mean() for k, v in val_results.items()}).sort_values()\n",
    "best_key = val_rank.index[0]\n",
    "best_scores, best_std = results[best_key], results_std[best_key]\n",
    "best_preds = predictions[best_key]                    # list (one frame per seed)\n",
    "best_pred = sum(best_preds) / len(best_preds)         # seed-mean, used for plots only\n",
    "\n",
    "print(\"Top 5 by VALIDATION mean CVRMSE:\")\n",
    "display(val_rank.head(5).rename(\"val mean CVRMSE\").to_frame().assign(\n",
    "    test_mean_CVRMSE=[results[k][\"CVRMSE\"].mean() for k in val_rank.index[:5]]).round(4))\n",
    "\n",
    "report = pd.DataFrame({\n",
    "    (\"model\", \"MAE\"): best_scores[\"MAE\"], (\"model\", \"MAE std\"): best_std[\"MAE\"],\n",
    "    (\"model\", \"CVRMSE\"): best_scores[\"CVRMSE\"], (\"model\", \"R2\"): best_scores[\"R2\"],\n",
    "    (\"persistence\", \"MAE\"): baseline_scores[\"MAE\"],\n",
    "    (\"seasonal pers.\", \"MAE\"): seasonal_scores[\"MAE\"],\n",
    "    (\"reference\", \"MAE\"): ref_scores[\"MAE\"],\n",
    "})\n",
    "report[(\"improvement vs reference\", \"MAE %\")] = 100 * (ref_scores[\"MAE\"] - best_scores[\"MAE\"]) / ref_scores[\"MAE\"]\n",
    "report[(\"improvement vs reference\", \"CVRMSE %\")] = 100 * (ref_scores[\"CVRMSE\"] - best_scores[\"CVRMSE\"]) / ref_scores[\"CVRMSE\"]\n",
    "report.columns = pd.MultiIndex.from_tuples(report.columns)\n",
    "print(f\"Validation-selected model: {best_key[0]}  |  {best_key[1]}   (params: {_fmt(best_params_log[best_key])})\")\n",
    "print(\"units: MAE degC for temp_*, %RH for hum_*; 'MAE std' = across seeds (0 for tabular)\")\n",
    "report.round(3)"
   ]
  },
