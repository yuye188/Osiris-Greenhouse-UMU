   "source": [
    "def tonly_name(mname):\n",
    "    if mname.endswith(\" (hist)\"):\n",
    "        return mname.replace(\" (hist)\", \"\")\n",
    "    if mname in (\"LSTM\", \"GRU\", \"Attention\", \"MLP\"):\n",
    "        return f\"{mname} (t only)\"\n",
    "    return mname\n",
    "\n",
    "mb = best_key[0]; mt = tonly_name(mb)\n",
    "regime_ci = {\n",
    "    f\"historical vs snapshot [{mt}]\": paired_diff(RG[\"pred\"][(mt, \"historical\")], RG[\"pred\"][(mt, \"snapshot\")],\n",
    "                                                   name_a=\"historical\", name_b=\"snapshot\"),\n",
    "    f\"NWP (matched) vs historical [{mb}]\": paired_diff(RG[\"pred\"][(mb, \"NWP (matched)\")], RG[\"pred\"][(mb, \"historical\")],\n",
    "                                                        name_a=\"NWP (matched)\", name_b=\"historical\"),\n",
    "    f\"oracle (matched) vs NWP (matched) [{mb}]\": paired_diff(RG[\"pred\"][(mb, \"oracle (matched)\")], RG[\"pred\"][(mb, \"NWP (matched)\")],\n",
    "                                                             name_a=\"oracle (matched)\", name_b=\"NWP (matched)\"),\n",
    "    f\"NWP (all 5 vars) vs NWP (matched) [{mb}]\": paired_diff(RG[\"pred\"][(mb, \"NWP (all 5 vars)\")], RG[\"pred\"][(mb, \"NWP (matched)\")],\n",
    "                                                             name_a=\"NWP (all 5 vars)\", name_b=\"NWP (matched)\"),\n",
    "}\n",
    "for title, t in regime_ci.items():\n",
    "    print(f\"\\n== {title}\")\n",
    "    display(t.round(3))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2.15 — Final model comparison plots\n",
    "\n",
    "Read off the results above (nothing is retrained): (a) test mean CVRMSE at the richest rung with seed error bars and both baselines; (b) the same across regimes; (c) neural models across rungs, mean ± std over seeds; (d) VPD event detection (episode recall and hourly F1) for the model and the baselines."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1100x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fs_plot = fs_best\n",
    "vals = pd.Series({mm: results[(mm, fs_plot)][\"CVRMSE\"].mean() for mm in MODEL_ORDER})\n",
    "errs = [np.std([s[\"CVRMSE\"].mean() for s in results_seeds[(mm, fs_plot)]]) for mm in MODEL_ORDER]\n",
    "fig, ax = plt.subplots(figsize=(11, 5))\n",
    "ax.bar(vals.index, vals.values, yerr=errs, capsize=3, color=\"#4C72B0\")\n",
    "ax.axhline(baseline_scores[\"CVRMSE\"].mean(), color=\"k\", ls=\"--\", lw=1, label=\"persistence\")\n",
    "ax.axhline(seasonal_scores[\"CVRMSE\"].mean(), color=\"k\", ls=\":\", lw=1, label=\"seasonal persistence\")\n",
