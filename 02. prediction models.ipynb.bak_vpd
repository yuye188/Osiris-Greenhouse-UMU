   ],
   "source": [
    "def make_attention(n_features, n_targets, lookback=MAX_LOOKBACK, units=64, dropout=0.0, lr=1e-3, optimizer=\"adam\", seed=0):\n",
    "    keras.utils.set_random_seed(seed)\n",
    "    inputs = layers.Input(shape=(lookback, n_features))\n",
    "    x = layers.Dense(units)(inputs)\n",
    "    positions = tf.range(start=0, limit=lookback, delta=1)\n",
    "    x = x + layers.Embedding(input_dim=lookback, output_dim=units)(positions)\n",
    "    attn_out = layers.MultiHeadAttention(num_heads=4, key_dim=max(units // 4, 8), dropout=dropout)(x, x)\n",
    "    x = layers.LayerNormalization()(x + attn_out)\n",
    "    ff = layers.Dense(units, activation=\"relu\")(x)\n",
    "    ff = layers.Dropout(dropout)(ff)\n",
    "    ff = layers.Dense(units)(ff)\n",
    "    x = layers.LayerNormalization()(x + ff)\n",
    "    x = layers.GlobalAveragePooling1D()(x)\n",
    "    x = layers.Dense(32, activation=\"tanh\")(x)\n",
    "    outputs = layers.Dense(n_targets)(x)\n",
    "    model = keras.Model(inputs, outputs)\n",
    "    model.compile(optimizer=make_optimizer(optimizer, lr), loss=\"mse\")\n",
    "    return model\n",
    "\n",
    "NEURAL_BUILDERS[\"Attention\"] = make_attention\n",
    "run_grid(\"Attention\", hist=True)\n",
    "run_grid(\"Attention\", hist=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bcad2618",
   "metadata": {},
   "source": [
    "## 2.7g — GRU and MLP, history and t only\n",
    "\n",
    "GRU: a simpler two-gate recurrent alternative to the LSTM. MLP: flattens the window and stacks two Dense layers — no notion of order at all — so \"MLP vs LSTM/GRU/Attention\" separates *having* the past window from *modelling its order*."
   ]
  },
