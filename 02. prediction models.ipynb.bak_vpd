   "source": [
    "RG = new_store()\n",
    "REGIME_COLS = {\n",
    "    \"snapshot\":         climate + ACTUATOR_COLS + cluster_cols,\n",
    "    \"NWP (matched)\":    climate + ACTUATOR_COLS + hist_cols + cluster_cols + NWP_MATCHED_COLS,\n",
    "    \"oracle (matched)\": climate + ACTUATOR_COLS + hist_cols + cluster_cols + ORACLE_MATCHED_COLS,\n",
    "}\n",
    "ARCHS = TABULAR + list(NEURAL_BUILDERS)\n",
    "for rg, cols in REGIME_COLS.items():\n",
    "    for arch in ARCHS:\n",
    "        for hist in ((False,) if rg == \"snapshot\" else (False, True)):\n",
    "            key = (model_key(arch, hist), rg)\n",
    "            out = run_model(arch, cols, hist, label=f\"regime_{key[0]}_{rg}\")\n",
    "            register(RG, key, out)\n",
    "            print(f\"{key[0]:>24} | {rg:<17} | val mean CVRMSE {out['val_crit']:.4f}\")\n",
    "\n",
    "# reuse the ladder for the other two regimes (no retraining)\n",
    "for mm in MODEL_ORDER:\n",
    "    for rg, fs in ((\"historical\", \"+ cluster\"), (\"NWP (all 5 vars)\", \"+ day-ahead forecast\")):\n",
    "        for store_key in RG:\n",
    "            RG[store_key][(mm, rg)] = GRID[store_key][(mm, fs)]\n",
    "\n",
    "REGIME_ORDER = [\"snapshot\", \"historical\", \"NWP (matched)\", \"oracle (matched)\", \"NWP (all 5 vars)\"]\n",
    "print(\"regime entries:\", len(RG[\"test\"]))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d8cab7b2",
   "metadata": {},
   "source": [
    "### 2.14a — How good is the forecast itself? (matched variables, test period)\n",
    "\n",
    "Forecast `previous_day1` value for *t+h* against the station observation at *t+h*. Radiation has a different band/unit on each side (see above), so it is judged mainly by its correlation; its MAE is shown after a linear shortwave→PAR mapping fitted on the **outer-train** period."
   ]
  },
