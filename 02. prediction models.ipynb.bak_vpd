   "source": [
    "def as_list(p):\n",
    "    return p if isinstance(p, list) else [p]\n",
    "\n",
    "def abs_err(preds, y):\n",
    "    preds = as_list(preds)\n",
    "    return sum((p.loc[y.index, TARGET_COLS] - y[TARGET_COLS]).abs() for p in preds) / len(preds)\n",
    "\n",
    "def block_bootstrap_ci(d, block=BOOT_BLOCK, n_boot=N_BOOT, seed=0):\n",
    "    d = np.asarray(d, dtype=float); n = len(d)\n",
    "    rng = np.random.default_rng(seed)\n",
    "    nb = int(np.ceil(n / block))\n",
    "    starts = rng.integers(0, n, size=(n_boot, nb))\n",
    "    idx = ((starts[:, :, None] + np.arange(block)[None, None, :]) % n).reshape(n_boot, -1)[:, :n]\n",
    "    bm = d[idx].mean(axis=1)\n",
    "    return np.quantile(bm, 0.025), np.quantile(bm, 0.975)\n",
    "\n",
    "def paired_diff(preds_a, preds_b, y=None, name_a=\"A\", name_b=\"B\"):\n",
    "    y = y_test if y is None else y\n",
    "    ea, eb = abs_err(preds_a, y), abs_err(preds_b, y)\n",
    "    rows = {}\n",
    "    for c in TARGET_COLS:\n",
    "        d = (ea[c] - eb[c]).values\n",
    "        lo, hi = block_bootstrap_ci(d)\n",
    "        rows[c] = {\"MAE A\": ea[c].mean(), \"MAE B\": eb[c].mean(), \"dMAE (A-B)\": d.mean(),\n",
    "                   \"CI 2.5%\": lo, \"CI 97.5%\": hi, \"CI excludes 0\": bool(lo > 0 or hi < 0)}\n",
    "    out = pd.DataFrame(rows).T\n",
    "    out.index.name = f\"A = {name_a}  |  B = {name_b}\"\n",
    "    return out\n",
    "\n",
    "def best_in(models, fs):\n",
    "    cands = [(m, fs) for m in models if (m, fs) in val_results]\n",
    "    return min(cands, key=lambda k: val_results[k][\"CVRMSE\"].mean())\n",
    "\n",
    "HIST_MODELS = [m for m in MODEL_ORDER if m.endswith(\"(hist)\") or m in (\"LSTM\", \"GRU\", \"Attention\", \"MLP\")]\n",
    "TONLY_MODELS = [m for m in MODEL_ORDER if m not in HIST_MODELS]\n",
    "TAB_MODELS = [m for m in MODEL_ORDER if m.split(\" \")[0] in TABULAR]\n",
    "\n",
    "bk_hist, bk_tonly = best_in(HIST_MODELS, fs_best), best_in(TONLY_MODELS, fs_best)\n",
    "bk_neural, bk_tab = best_in(NEURAL_MODELS, fs_best), best_in(TAB_MODELS, fs_best)\n",
    "\n",
    "bootstrap_tables = {\n",
    "    \"selected vs reference baseline\": paired_diff(best_preds, ref_baseline, name_a=str(best_key), name_b=\"reference baseline\"),\n",
    "    \"selected vs seasonal persistence\": paired_diff(best_preds, baselines_test[\"seasonal persistence\"], name_a=str(best_key), name_b=\"seasonal persistence\"),\n",
    "    \"selected vs persistence\": paired_diff(best_preds, baselines_test[\"persistence\"], name_a=str(best_key), name_b=\"persistence\"),\n",
    "    \"history vs t only\": paired_diff(predictions[bk_hist], predictions[bk_tonly], name_a=bk_hist[0], name_b=bk_tonly[0]),\n",
    "    \"neural vs tabular\": paired_diff(predictions[bk_neural], predictions[bk_tab], name_a=bk_neural[0], name_b=bk_tab[0]),\n",
    "}\n",
    "for title, t in bootstrap_tables.items():\n",
    "    print(f\"\\n== {title} (test, 95% block-bootstrap CI, {N_BOOT} replicates, {BOOT_BLOCK} h blocks)\")\n",
    "    display(t.round(3))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a86c7ddb",
   "metadata": {},
   "source": [
    "## 2.9 — ❓ Does the climatic-system data actually help?\n",
    "\n",
    "Two complementary views, now with uncertainty:\n",
    "\n",
    "* **Ablation** — for the validation-selected architecture, per-target MAE with *no actuators* vs *+ actuators (current)* and *+ actuator history*, with paired block-bootstrap CIs. A negative ΔMAE whose CI excludes 0 is evidence that the climatic-system features help.\n",
    "* **Importance share** — how much of a Random Forest's impurity importance the actuator features (current + history) collect (2.12), and their share of permutation importance on test, computed **separately for temperature and humidity** (2.12b)."
   ]
  },
