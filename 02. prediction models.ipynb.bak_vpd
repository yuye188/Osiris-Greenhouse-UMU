   ],
   "source": [
    "splits = get_splits(root=\".\")\n",
    "EMBARGO_HOURS = splits[\"embargo_hours\"]\n",
    "for k, v in splits.items():\n",
    "    print(f\"{k:>16}: {v}\")\n",
    "\n",
    "# Notebook 1 must have been run with the same split (it saves it in the joblib).\n",
    "import joblib\n",
    "_cm = joblib.load(\"model data/cluster_model.joblib\")\n",
    "assert _cm.get(\"splits\", {}).get(\"test_start\") == splits[\"test_start\"] and \\\n",
    "       _cm[\"splits\"][\"inner_train_end\"] == splits[\"inner_train_end\"], \\\n",
    "    \"clusters.csv was produced with a different split -- re-run notebook 1 first\"\n",
    "\n",
    "MAX_LOOKBACK = 24                    # longest history window any model may use\n",
    "LOOKBACK_GRID = (3, 24) if SMOKE else (3, 6, 12, 24)   # history lengths searched on validation (2.7, 2.7n)\n",
    "\n",
    "ts = data.index.values\n",
    "pos = np.arange(len(data))\n",
    "valid_anchor = np.zeros(len(data), dtype=bool)\n",
    "ok = pos >= MAX_LOOKBACK - 1\n",
    "valid_anchor[ok] = (ts[pos[ok]] - ts[pos[ok] - MAX_LOOKBACK + 1]) == np.timedelta64(MAX_LOOKBACK - 1, \"h\")\n",
    "anchors = data.index[valid_anchor]\n",
    "\n",
    "idx_inner = anchors[anchors < splits[\"inner_train_end\"]]\n",
    "idx_val = anchors[(anchors >= splits[\"val_start\"]) & (anchors < splits[\"train_end\"])]\n",
    "idx_train = anchors[anchors < splits[\"train_end\"]]\n",
    "idx_test = anchors[anchors >= splits[\"test_start\"]]\n",
    "\n",
    "n_test_rows = int((data.index >= splits[\"test_start\"]).sum())\n",
    "print(f\"\\nanchors with a complete 24 h history: {len(anchors)} of {len(data)} rows\")\n",
    "print(f\"inner train: {len(idx_inner)}  | validation: {len(idx_val)} ({idx_val.min()} -> {idx_val.max()})\")\n",
    "print(f\"outer train: {len(idx_train)}  | test: {len(idx_test)} of {n_test_rows} test rows \"\n",
    "      f\"({idx_test.min()} -> {idx_test.max()})\")\n",
    "\n",
    "# embargo sanity checks: every target of an earlier period is observed before the next period starts\n",
    "assert (idx_inner + pd.Timedelta(hours=max(HORIZONS)) < splits[\"val_start\"]).all()\n",
    "assert (idx_train + pd.Timedelta(hours=max(HORIZONS)) < splits[\"test_start\"]).all()\n",
    "\n",
    "train, val, test = data.loc[idx_train], data.loc[idx_val], data.loc[idx_test]\n",
    "y_train, y_val, y_test = train[TARGET_COLS], val[TARGET_COLS], test[TARGET_COLS]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fb137bf3",
