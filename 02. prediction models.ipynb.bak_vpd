       "GRU (t only)          5.096 ± 0.096         4.820 ± 0.109      4.481 ± 0.076  4.458 ± 0.158        3.661 ± 0.127\n",
       "Attention (t only)    5.119 ± 0.261         4.860 ± 0.282      4.497 ± 0.188  4.343 ± 0.252        3.828 ± 0.076\n",
       "MLP (t only)          4.584 ± 0.238         4.573 ± 0.209      4.248 ± 0.154  4.363 ± 0.140        3.700 ± 0.148\n",
       "Ridge (hist)                  4.523                 4.947              5.277          5.305                3.915\n",
       "RandomForest (hist)           4.762                 4.764              4.746           4.72                 3.99\n",
       "HistGB (hist)                 4.083                 4.063              3.902          3.909                3.377\n",
       "LSTM                  4.643 ± 0.221         4.324 ± 0.081      4.223 ± 0.100  4.139 ± 0.098        3.694 ± 0.071\n",
       "GRU                   4.427 ± 0.132         4.462 ± 0.198      4.281 ± 0.177  4.799 ± 0.178        3.740 ± 0.152\n",
       "Attention             5.755 ± 1.016         5.495 ± 0.676      4.545 ± 0.415  6.001 ± 1.060        4.138 ± 0.146\n",
       "MLP                   4.938 ± 0.274         5.480 ± 0.450      4.762 ± 0.237  5.043 ± 0.228        3.889 ± 0.311\n",
       "persistence                   7.880                 7.880              7.880          7.880                7.880\n",
