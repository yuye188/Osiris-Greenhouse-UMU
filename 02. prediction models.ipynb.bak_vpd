   "source": [
    "fs_show = \"+ day-ahead forecast\"\n",
    "fig, axes = plt.subplots(1, 2, figsize=(15, 5))\n",
    "for ax, var, label in zip(axes, [\"temp\", \"hum\"], [\"Temperature MAE (°C)\", \"Humidity MAE (%)\"]):\n",
    "    cols = [f\"{var}_h{h}\" for h in HORIZONS]\n",
    "    x = np.arange(3); w = 0.8 / len(MODEL_ORDER)\n",
    "    for i, mm in enumerate(MODEL_ORDER):\n",
    "        err = results_std[(mm, fs_show)].loc[cols, \"MAE\"].values if mm in NEURAL_MODELS else None\n",
    "        ax.bar(x + i * w, results[(mm, fs_show)].loc[cols, \"MAE\"].values, w, yerr=err, capsize=2, label=mm)\n",
    "    ax.plot(x + 0.4 - w / 2, baseline_scores.loc[cols, \"MAE\"].values, \"k--o\", label=\"persistence\")\n",
    "    ax.plot(x + 0.4 - w / 2, seasonal_scores.loc[cols, \"MAE\"].values, \"k:s\", label=\"seasonal persistence\")\n",
    "    ax.set_xticks(x + 0.4 - w / 2); ax.set_xticklabels([f\"+{h}h\" for h in HORIZONS])\n",
    "    ax.set_title(label); ax.set_xlabel(\"horizon\")\n",
    "axes[0].set_ylabel(\"MAE\"); axes[1].legend(bbox_to_anchor=(1.01, 1), fontsize=7)\n",
    "plt.suptitle(f\"Feature set: {fs_show} (test)\"); plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c897832d",
   "metadata": {},
   "source": [
    "**How to read this.** At **+1 h** plain persistence is already strong. At **+6/+12 h** plain persistence is a weak reference because of the daily cycle — **seasonal persistence** is the fair reference there, and the real forecasting gain is the gap to the dotted line, which is much smaller than the gap to the dashed one. Whether that gap is larger than the sampling noise of a ~12-day test window is answered by the CIs in 2.8d."
   ]
  },
